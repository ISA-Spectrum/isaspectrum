# Cloudflare Pages _headers
#
# Two parser rules matter here:
#   1. Path patterns MUST start with "/". Bare patterns such as "*.js" are rejected,
#      which silently dropped every JS/CSS/font cache rule before.
#   2. When several rules match one request, their headers are merged and duplicate
#      header names are joined with ", ". So a no-cache file must first detach the
#      broad rule's Cache-Control with "! Cache-Control" before setting its own.
#
# Broad rules come first so that the "!" detach in the specific rules below applies.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# /images/* already covers /images/site.webmanifest, so no separate rule is needed.
/images/*
  Cache-Control: public, max-age=604800, s-maxage=604800, immutable

/favicon*
  Cache-Control: public, max-age=604800, s-maxage=604800

/*.js
  Cache-Control: public, max-age=259200, s-maxage=259200

/*.css
  Cache-Control: public, max-age=259200, s-maxage=259200

# These must never be cached, but /*.js and /* match them too, so detach first.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/auth-client.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/home.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/meal-rating.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/checker-ui.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/*.woff2
  Cache-Control: public, max-age=604800, s-maxage=604800

/*.woff
  Cache-Control: public, max-age=604800, s-maxage=604800

/*.ttf
  Cache-Control: public, max-age=604800, s-maxage=604800
