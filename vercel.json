{
  "cleanUrls": true,
  "functions": {
    "functions/**/*.js": {
      "runtime": "@vercel/node@5.6.18"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/functions/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/functions/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://isaspectrum.celestivast.com" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}